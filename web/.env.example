# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA subas .env.local a git (ya está en .gitignore).
#
# Cuando agregues nuevas variables, actualiza también src/env.ts

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Base de datos (Supabase Postgres)
# Obtén la cadena de conexión en:
#   Supabase → Settings → Database → Connection string → "URI"
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Flags para operaciones de Drizzle
DB_MIGRATING="false"
DB_SEEDING="false"

# -----------------------------------------------------------------------------
# Autenticación (Better Auth)
# 🔐 Genera con: openssl rand -base64 32
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=""

# Google OAuth 2.0 (opcional — si usas login con Google)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# ml-service — Servicio Python (FastAPI en Render)
# ⚠️  NUNCA usar NEXT_PUBLIC_* para estas variables — son server-only
# -----------------------------------------------------------------------------
# URL del servicio FastAPI (en desarrollo: http://localhost:8000)
ML_SERVICE_URL="http://localhost:8000"

# Clave interna compartida con el ml-service.
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
# El mismo valor debe estar en ML_SERVICE_API_KEY del ml-service/.env
ML_SERVICE_API_KEY=""

