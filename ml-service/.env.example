# ============================================================
# ml-service — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env a git (ya está en .gitignore).
# ============================================================

# ----------------------------------------------------------
# Base de datos (Supabase Postgres — mismo que usa Next.js)
# Obtén la cadena de conexión en:
#   Supabase → Settings → Database → Connection string → "URI"
# Usa la versión con ?pgbouncer=true para producción
# ----------------------------------------------------------
DATABASE_URL="postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ----------------------------------------------------------
# Seguridad interna
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
# El mismo valor debe estar en NEXT_PUBLIC_ML_SERVICE_API_KEY
# (variable server-only en Next.js — nunca en el cliente)
# ----------------------------------------------------------
ML_SERVICE_API_KEY=""

# ----------------------------------------------------------
# APIs de datos de mercado
# ----------------------------------------------------------
# Alpha Vantage — https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=""

# ----------------------------------------------------------
# Configuración del servicio
# ----------------------------------------------------------
ENVIRONMENT="development"   # "production" en Render
LOG_LEVEL="INFO"

# ----------------------------------------------------------
# LSTM — parámetros de reentrenamiento (ver §4.2 del plan)
# ----------------------------------------------------------
LSTM_TRAINING_WINDOW_MONTHS="24"   # ventana de historial para entrenar
LSTM_RETRAIN_DAY="1"               # día del mes para el Cron Job mensual
